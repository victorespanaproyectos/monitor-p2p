DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Generate a private value before production; never commit .env.
DJANGO_SECRET_KEY=
# Local mode: sqlite. Portfolio deployment: postgresql.
DB_ENGINE=sqlite
DB_NAME=p2p
DB_USER=p2p
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Set to 1 only when serving through HTTPS in production.
DJANGO_HTTPS=0
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 = simulated Binance ads, clearly identified in the interface.
P2P_MARKET_DEMO=0
